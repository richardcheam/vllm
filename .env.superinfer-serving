# Maximum-throughput serving profile for DeepSeek-V4/DSpark.
# This intentionally enables high-risk DSpark rotation. Use the normal
# .env.superinfer-service128 profile as the rollback configuration.
#
# Start inside richard-base-dev-sysnice with:
#   scripts/launch_superinfer.sh .env.superinfer-serving

MODEL_PATH=/workspace/models/DeepSeek-V4-Flash-0731
TOKENIZER_PATH=/workspace/models/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash-0731
VLLM_HOST=0.0.0.0
VLLM_PORT=8202
PROFILE=superinfer-high-risk

TP_SIZE=2
PP_SIZE=1
NUMA_BIND=1
NUMA_BIND_NODES=0,1
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=24
MAX_NUM_BATCHED_TOKENS=32768
BLOCK_SIZE=256
KV_CACHE_DTYPE=fp8
ENABLE_PREFIX_CACHING=1
NUM_SPECULATIVE_TOKENS=5

# 128 GiB total, approximately 64 GiB per TP rank.
SWAP_CPU_MEMORY_GB=128
CPU_KV_ALLOCATION_MODE=empty
NATIVE_COPY_BACKEND=0

# Maximum-throughput scheduler policy. High-risk mode permits proactive DSpark
# rotation; block-first remains disabled because DeepSeek-V4 layout equivalence
# is not validated for TP=2.
PROACTIVE_SWAP_BUDGET=2400
VLT_ALPHA=3
VLT_BETA_BANDWIDTH=1
VLT_BETA_FUTURE=1
SLO_TTFT=5
SLO_TBT=0.1
SWAPPER_BLOCK_FIRST=0
PIN_MEMORY_FIX=1
SUPERINFER_HIGH_RISK_MODE=1
GH200_TOPOLOGY_TUNED=1
LOCAL_CPU_POOL_FRACTION=0.75
LOCAL_SWAP_BANDWIDTH_BYTES_PER_S=966367641600
REMOTE_SWAP_BANDWIDTH_BYTES_PER_S=300647710720

LOG_DIR=/workspace/re-SuperInfer/vllm-superinfer-v4/logs
STATE_DIR=/workspace/re-SuperInfer/vllm-superinfer-v4/.run
STARTUP_TIMEOUT_S=3600
SHUTDOWN_TIMEOUT_S=60

# Short best-effort post-readiness warmup. The exhaustive ladder is benchmark-only.
LAUNCH_WARMUP_ENABLED=1
LAUNCH_WARMUP_TIMEOUT_S=300
LAUNCH_WARMUP_OUTPUT_DIR=/workspace/re-SuperInfer/benchmark_artifacts/serving_warmup
LAUNCH_WARMUP_ROBUST_USERS=1
LAUNCH_WARMUP_ROBUST_REQUESTS=2
LAUNCH_WARMUP_ROBUST_PROMPT_LEN=4096
LAUNCH_WARMUP_ROBUST_MAX_TOKENS=64
LAUNCH_WARMUP_BASIC_USERS=4
LAUNCH_WARMUP_BASIC_REQUESTS=8
LAUNCH_WARMUP_BASIC_PROMPT_LEN=4096
LAUNCH_WARMUP_BASIC_MAX_TOKENS=64

BENCH_URL=http://127.0.0.1:8202
