# Topology-aware SuperInfer + DSpark profile.
# Select with: cp .env.superinfer .env

MODEL_PATH=/workspace/models/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash-0731
VLLM_HOST=0.0.0.0
VLLM_PORT=8202
PROFILE=superinfer

TP_SIZE=2
PP_SIZE=1
NUMA_BIND=1
NUMA_BIND_NODES=0,1
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=16384
BLOCK_SIZE=256
KV_CACHE_DTYPE=fp8
ENABLE_PREFIX_CACHING=1
NUM_SPECULATIVE_TOKENS=5
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=deepseek_v4
REASONING_PARSER=deepseek_v4
LAUNCH_WARMUP_ENABLED=1
LAUNCH_WARMUP_TIMEOUT_S=300
LAUNCH_WARMUP_ROBUST_USERS=1
LAUNCH_WARMUP_ROBUST_REQUESTS=2
LAUNCH_WARMUP_ROBUST_PROMPT_LEN=4096
LAUNCH_WARMUP_ROBUST_MAX_TOKENS=64
LAUNCH_WARMUP_BASIC_USERS=4
LAUNCH_WARMUP_BASIC_REQUESTS=8
LAUNCH_WARMUP_BASIC_PROMPT_LEN=4096
LAUNCH_WARMUP_BASIC_MAX_TOKENS=64

# SuperInfer CPU KV capacity. Start at 8 GiB, then tune after validation.
SWAP_CPU_MEMORY_GB=8
CPU_KV_ALLOCATION_MODE=zero
PROACTIVE_SWAP_BUDGET=2400
VLT_ALPHA=3
VLT_BETA_BANDWIDTH=1
VLT_BETA_FUTURE=1
SLO_TTFT=5
SLO_TBT=0.1
SWAPPER_BLOCK_FIRST=0
PIN_MEMORY_FIX=1
SUPERINFER_HIGH_RISK_MODE=0
GH200_TOPOLOGY_TUNED=1
LOCAL_CPU_POOL_FRACTION=0.75
LOCAL_SWAP_BANDWIDTH_BYTES_PER_S=966367641600
REMOTE_SWAP_BANDWIDTH_BYTES_PER_S=300647710720

LOG_DIR=/workspace/re-SuperInfer/vllm-superinfer-v4/logs
STATE_DIR=/workspace/re-SuperInfer/vllm-superinfer-v4/.run
STARTUP_TIMEOUT_S=3600
SHUTDOWN_TIMEOUT_S=60

BENCH_URL=http://127.0.0.1:8202
BENCH_CLIENT=robust
BENCH_SEED=20260803
BENCH_USERS=24
BENCH_REQUESTS=120
BENCH_PROMPT_LEN=16384
BENCH_MAX_TOKENS=256
BENCH_REPEATS=3
BENCH_OUTPUT_DIR=/workspace/re-SuperInfer/benchmark_artifacts/vllm-superinfer-v4

WARMUP_ENABLED=1
WARMUP_MODE=exhaustive
WARMUP_STAGES=6
WARMUP_CLIENT=robust
WARMUP_SEED=20260803
WARMUP_SATURATION_SOAK=1
WARMUP_PROMPT_LENGTHS=4096,16384,65536,131072,262144,524288
WARMUP_USERS=4,8,16,24,32,32
WARMUP_REQUESTS=8,32,64,96,128,128
WARMUP_MAX_TOKENS=32,64,128,256,256,256
