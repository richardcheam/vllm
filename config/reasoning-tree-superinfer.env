# Production recipe for DeepSeek-V4-Flash-0731 on the validated GH200 host.
# Values use ${VAR:-default} so explicit environment or CLI overrides remain
# possible for controlled diagnostics. Keep this file free of credentials.

PROFILE="${PROFILE:-superinfer}"
CONTAINER_NAME="${CONTAINER_NAME:-richard-base-dev-sysnice}"
PORT="${PORT:-8202}"
WORKDIR="${WORKDIR:-/workspace/re-SuperInfer/vllm-modern-reasoning}"

MODEL_PATH="${MODEL_PATH:-/workspace/re-SuperInfer/models--deepseek-ai--DeepSeek-V4-Flash-0731/snapshots/7872f01b1d1fe23eabc4c98b48bffcef5a386062}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-deepseek-ai/DeepSeek-V4-Flash-0731}"

GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.92}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-1048576}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-24}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-32768}"
NUM_SPECULATIVE_TOKENS="${NUM_SPECULATIVE_TOKENS:-0}"
BLOCK_SIZE="${BLOCK_SIZE:-256}"
SWAP_CPU_MEMORY_GB="${SWAP_CPU_MEMORY_GB:-128}"

PROACTIVE_SWAP_BUDGET="${PROACTIVE_SWAP_BUDGET:-2400}"
CAPACITY_WAIT_TIMEOUT="${CAPACITY_WAIT_TIMEOUT:-30}"
VLT_ALPHA="${VLT_ALPHA:-3}"
VLT_BETA_BANDWIDTH="${VLT_BETA_BANDWIDTH:-1}"
VLT_BETA_FUTURE="${VLT_BETA_FUTURE:-1}"
SLO_TTFT="${SLO_TTFT:-5}"
SLO_TBT="${SLO_TBT:-0.1}"

SUPERINFER_HIGH_RISK_MODE="${SUPERINFER_HIGH_RISK_MODE:-0}"
GH200_TOPOLOGY_TUNED="${GH200_TOPOLOGY_TUNED:-1}"
SWAPPER_BLOCK_FIRST="${SWAPPER_BLOCK_FIRST:-0}"
NUMA_BIND="${NUMA_BIND:-1}"
NUMA_BIND_NODES="${NUMA_BIND_NODES:-0 1}"
LOCAL_CPU_POOL_FRACTION="${LOCAL_CPU_POOL_FRACTION:-0.75}"
LOCAL_SWAP_BANDWIDTH_BYTES_PER_S="${LOCAL_SWAP_BANDWIDTH_BYTES_PER_S:-966367641600}"
REMOTE_SWAP_BANDWIDTH_BYTES_PER_S="${REMOTE_SWAP_BANDWIDTH_BYTES_PER_S:-300647710720}"

DISTRIBUTED_EXECUTOR_BACKEND="${DISTRIBUTED_EXECUTOR_BACKEND:-}"
GENERATION_CONFIG="${GENERATION_CONFIG:-}"
ENFORCE_EAGER="${ENFORCE_EAGER:-0}"

# Host-side operator defaults. LOG_NAME is generated per start by start.sh.
LOG_DIR="${LOG_DIR:-}"
LOG_BASENAME="${LOG_BASENAME:-direct_reasoning_superinfer_8202}"
STARTUP_TIMEOUT_S="${STARTUP_TIMEOUT_S:-3600}"
WARMUP_ENABLED="${WARMUP_ENABLED:-1}"
WARMUP_REQUESTS="${WARMUP_REQUESTS:-3}"
WARMUP_MAX_TOKENS="${WARMUP_MAX_TOKENS:-8}"
WARMUP_TIMEOUT_S="${WARMUP_TIMEOUT_S:-120}"
WARMUP_MODEL="${WARMUP_MODEL:-deepseek-ai/DeepSeek-V4-Flash-0731}"
WARMUP_PROMPT="${WARMUP_PROMPT:-Short startup warmup request. Reply with one brief sentence.}"

# Failure-only evidence collection. Disabled so healthy startup has no extra
# Docker/GPU/process inspection overhead.
COLLECT_START_FAILURE_DIAGNOSTICS="${COLLECT_START_FAILURE_DIAGNOSTICS:-0}"
DIAGNOSTICS_LOG_TAIL_LINES="${DIAGNOSTICS_LOG_TAIL_LINES:-200}"
DIAGNOSTICS_DOCKER_LOG_SINCE="${DIAGNOSTICS_DOCKER_LOG_SINCE:-15m}"

# User-service supervision defaults. systemd owns restart/backoff; the
# repository supervisor only observes and records failures.
SUPERVISOR_HEALTH_INTERVAL_S="${SUPERVISOR_HEALTH_INTERVAL_S:-10}"
SUPERVISOR_HEALTH_FAILURE_THRESHOLD="${SUPERVISOR_HEALTH_FAILURE_THRESHOLD:-3}"
SUPERVISOR_COLLECT_DIAGNOSTICS="${SUPERVISOR_COLLECT_DIAGNOSTICS:-1}"
SUPERVISOR_STARTUP_TIMEOUT_S="${SUPERVISOR_STARTUP_TIMEOUT_S:-600}"
SUPERVISOR_CONTAINER_RECOVERY="${SUPERVISOR_CONTAINER_RECOVERY:-restart}"
SUPERVISOR_CONTAINER_RESTART_TIMEOUT_S="${SUPERVISOR_CONTAINER_RESTART_TIMEOUT_S:-30}"
SUPERVISOR_GPU_RECOVERY_WAIT_S="${SUPERVISOR_GPU_RECOVERY_WAIT_S:-15}"
