{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate (success/s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(vllm:request_success_total[1m]))",
          "legendFormat": "success/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Running / Waiting Requests",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running",
          "refId": "A"
        },
        {
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV Cache Usage (%)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "max(vllm:kv_cache_usage_perc) * 100",
          "legendFormat": "kv_cache_usage_pct",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "TTFT P50/P90/P99 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "ttft_p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "ttft_p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "ttft_p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU VRAM Used (MiB)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "max_over_time(vllm_gpu_memory_used_bytes[1m]) / 1048576",
          "legendFormat": "vllm_gpu_mem_used_mib",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Busy (%)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "cpu_busy",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NUMA Free Memory (bytes)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "numa_node_memfree_bytes",
          "legendFormat": "node{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NUMA Hit/Miss",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "rate(numa_numa_hit_total[1m])",
          "legendFormat": "numa_hit/s",
          "refId": "A"
        },
        {
          "expr": "rate(numa_numa_miss_total[1m])",
          "legendFormat": "numa_miss/s",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["vllm", "daily", "topology"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "vLLM Daily Ops (Local)",
  "uid": "vllm-daily-ops-local",
  "version": 1
}
