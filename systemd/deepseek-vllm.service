[Unit]
Description=DeepSeek vLLM service
After=docker.service
ConditionPathExists=%h/re-SuperInfer/vllm-modern-reasoning/start.sh
ConditionPathExists=%h/re-SuperInfer/vllm-modern-reasoning/config/reasoning-tree-superinfer.env
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/re-SuperInfer/vllm-modern-reasoning
ExecStart=%h/re-SuperInfer/vllm-modern-reasoning/scripts/run_supervised.sh --config %h/re-SuperInfer/vllm-modern-reasoning/config/reasoning-tree-superinfer.env
Restart=on-failure
RestartSec=60s
TimeoutStartSec=10min
TimeoutStopSec=180s
KillMode=process

[Install]
WantedBy=default.target
